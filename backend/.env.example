# FastAPIがDBに接続するための接続文字列。
# 値は root の .env (docker-compose用) と揃える必要がある。
# 形式: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://techcompare:changeme@localhost:5432/techcompare

# LLM API (Google Gemini)。取得方法・設定方法はREADMEの
# 「LLM APIキーの設定」を参照。ここには値を書かず、変数名だけを残す。
GEMINI_API_KEY=

# Web検索API (Tavily)。取得方法・設定方法はREADMEの
# 「Tavily APIキーの設定」を参照。ここには値を書かず、変数名だけを残す。
TAVILY_API_KEY=
